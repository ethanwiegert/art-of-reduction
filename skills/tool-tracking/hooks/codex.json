{
  "description": "Record every tool call into the shared art-of-reduction log.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/REPLACE/WITH/ABSOLUTE/PATH/hooks/codex.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
